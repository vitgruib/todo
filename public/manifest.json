{
    "manifest_version": 3,
    "name": "Todo",
    "version": "1.0.0",
    "description": "A todo list extension with drag-and-drop and deadline reminders.",
    "permissions": [
        "storage",
        "alarms",
        "tabs",
        "offscreen"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "index.html"
    }
}
